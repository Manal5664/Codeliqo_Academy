# Supabase-hosted Edge Functions provide these values automatically.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEYS={"default":"sb_secret_your-key"}

# Legacy projects can use this instead of SUPABASE_SECRET_KEYS.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for invitation and existing-account password setup emails. Add this
# exact URL to Supabase Auth's redirect allow list.
STUDENT_INVITE_REDIRECT_URL=https://academy.example.com/student/accept-invite
